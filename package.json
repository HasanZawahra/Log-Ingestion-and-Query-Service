{
  "name": "ft-final-project",
  "version": "1.0.0",
  "description": "",
  "_comment": "Scripts are organized for local development, CI, and production startup.",
  "scripts": {
    "test": "vitest run",
    "_comment_scripts": "build compiles TypeScript, migrate:prod applies migrations in Docker, and lint/format keep the repo clean.",
    "build": "npx tsc",
    "start": "node dist/server.js",
    "dev": "npx tsc && node dist/server.js",
    "migrate:prod": "node --import tsx ./src/scripts/run-migrations.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate": "npx drizzle-kit generate",
    "migrate": "npx drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.9"
  }
}
